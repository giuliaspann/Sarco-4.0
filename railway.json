{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": [
      "python manage.py prepara_deploy"
    ],
    "startCommand": "gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 2 --timeout 90 --log-file -",
    "healthcheckPath": "/health/",
    "restartPolicyType": "ON_FAILURE"
  }
}
