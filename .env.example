# Copia in .env per lo sviluppo locale
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Senza DATABASE_URL si usa SQLite locale
# DATABASE_URL=postgresql://user:password@localhost:5432/sarco
# Primo utente dell'ufficio, creato al deploy se non esiste (vedi turni/management/commands/prepara_deploy.py)
# SARCO_ADMIN_USER=
# SARCO_ADMIN_PASSWORD=
# Foto delle pulizie: su Railway il volume è montato su /data
# MEDIA_ROOT=/data/media
